@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<AuthorizeView>
    <Authorized>
        <div class="page">
            <div class="sidebar">
                <NavMenu />
            </div>

            <main>
                <header class="account-header px-4">
                    <AccountMenu />
                </header>

                <article class="content px-4">
                    @Body
                </article>
            </main>
        </div>
    </Authorized>

    <NotAuthorized>
        <main class="container py-5">
            <h1>Du behöver logga in</h1>
            <p>Logga in för att använda FastighetsFix.</p>
            <a href="/login" class="btn btn-primary">
                Till inloggning
            </a>
        </main>
    </NotAuthorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    Ett oväntat fel har inträffat.
    <a href="." class="reload">Ladda om</a>
    <a class="dismiss">🗙</a>
</div>
