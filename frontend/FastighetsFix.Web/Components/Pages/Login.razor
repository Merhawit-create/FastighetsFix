@page "/"
@page "/login"
@layout FastighetsFix.Web.Components.Layout.AuthLayout

@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Routing

@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Logga in – FastighetsFix</PageTitle>

<h1>Logga in</h1>

@if (ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">
        @ErrorMessage
    </div>
}

<form method="post"
      action="/auth/login"
      data-enhance="false">

    <AntiforgeryToken />

    <div class="mb-3">
        <label for="email" class="form-label">
            E-postadress
        </label>

        <input id="email"
               name="Email"
               type="email"
               class="form-control"
               autocomplete="username"
               maxlength="256"
               required />
    </div>

    <div class="mb-3">
        <label for="password" class="form-label">
            Lösenord
        </label>

        <input id="password"
               name="Password"
               type="password"
               class="form-control"
               autocomplete="current-password"
               required />
    </div>

    <button type="submit" class="btn btn-primary">
        Logga in
    </button>
</form>

<p class="mt-3">
    Saknar du konto?
    <a href="/register">Skapa konto</a>
</p>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private string? ErrorMessage => Error switch
    {
        "invalid" =>
            "Inloggningen misslyckades. Kontrollera uppgifterna. "
            + "Kontot kan också vara tillfälligt låst.",

        "unavailable" =>
            "Vi kan inte logga in dig just nu. Försök igen om en stund.",

        "logout" =>
            "Du är utloggad lokalt, men API:et kunde inte "
            + "bekräfta återkallningen av dina token.",

        _ => null
    };
}